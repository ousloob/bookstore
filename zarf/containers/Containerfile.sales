# Build the Go binary.
FROM golang:1.27 AS build
ENV CGO_ENABLED=0
ARG BUILD_REF
WORKDIR /service
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags "-X main.build=${BUILD_REF}" -o sales ./api/sales
# The admin tool ships in the same image so the binary that migrates the
# schema and the binary that serves traffic are built from the same commit.
RUN go build -ldflags "-X main.build=${BUILD_REF}" -o admin ./api/tooling/admin

# Run the Go binary in a minimal image with a shell for debugging.
FROM alpine:3.23
ARG BUILD_REF
RUN addgroup -g 1000 -S sales && \
    adduser -u 1000 -h /service -G sales -S sales
COPY --from=build --chown=sales:sales /service/sales /service/sales
COPY --from=build --chown=sales:sales /service/admin /service/admin
WORKDIR /service
USER sales
CMD ["./sales"]

LABEL org.opencontainers.image.title="sales-api" \
      org.opencontainers.image.revision="${BUILD_REF}" \
      org.opencontainers.image.source="https://github.com/ousloob/bookstore"
